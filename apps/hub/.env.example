# OmniForce hub Supabase project (NOT the WSSO project)
VITE_SUPABASE_URL=https://YOUR-HUB-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Public landing page, for "back to site" links
VITE_LANDING_URL=http://localhost:3000
# Leave Supabase vars empty to run the hub with demo data.
# VITE_DEMO=1 forces demo mode. VITE_HASH_ROUTER=1 uses #/routes (static hosting).
# Customers buy plans themselves (Stripe checkout) only when this is 1. Default: people sign up,
# and a platform admin gives access in Admin > Users / Organizations.
VITE_SELF_SERVE_BILLING=
