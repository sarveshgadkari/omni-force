# Edge function secrets for the OmniForce hub:  supabase secrets set --env-file supabase/functions/.env
# Shared secrets must be at least 32 characters; endpoints refuse all requests while one is missing.

# Hub origin(s) allowed as Stripe return URLs and used for /oauth/authorize (comma-separated, exact origins)
HUB_ORIGIN=https://account.omniforce.app

STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_AUTOMATIC_TAX=0

# Token signing. ES256 private key as JWK JSON with a "kid" (node scripts/gen-sso-key.mjs).
SSO_PRIVATE_JWK={"kty":"EC","crv":"P-256","x":"…","y":"…","d":"…","kid":"of-2026-10"}
# During a key rotation: JSON array of the previous PUBLIC keys. Otherwise leave empty.
SSO_PREVIOUS_PUBLIC_JWKS=
# Issuer = the public URL of the oidc function (or a custom domain proxying it)
SSO_ISSUER=https://<hub-ref>.supabase.co/functions/v1/oidc

# Drone Directory (DirectoryUp / Brilliant Directories). Used when Directory
# provisioning or token SSO is enabled in Admin → Applications.
# API key permissions: Users GET/POST/PUT, User Metadata GET/POST/PUT,
# Sensitive Data → Include User Token.
DIRECTORYUP_API_BASE=https://drones-drones-drones.directoryup.com/api/v2
DIRECTORYUP_API_KEY=bd_xxx
DIRECTORYUP_SITE_ORIGIN=https://drones-drones-drones.directoryup.com
DIRECTORYUP_FREE_SUBSCRIPTION_ID=1
DIRECTORYUP_WEBHOOK_TOKEN=

# WSSO access events (used by sync-worker once WSSO provisioning is enabled in Admin > Integrations).
# WSSO_EVENTS_SECRET must equal OMNIFORCE_EVENTS_SECRET in WSSO's environment.
WSSO_EVENTS_URL=https://wsso.tlbisbig.world/api/omniforce/events
WSSO_EVENTS_SECRET=
# Inbound WSSO webhooks (wsso-webhook). Not sent by WSSO yet; leave empty.
WSSO_SHARED_SECRET=

# pg_cron → sync-worker
CRON_SECRET=
